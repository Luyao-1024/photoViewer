using Gtk 4.0;

// ModeSelector: 3 label cells + 3 dot cells. The two rows fill the
// translucent panel and use `homogeneous: true` so each label_cell_i is
// the same width as dot_cell_i — keeping the active dot aligned under
// its label and avoiding leftover panel space after the Day cell.
template $ModeSelector : Gtk.Box {
  orientation: vertical;
  css-classes: ["mode-selector", "glass-raised"];

  Gtk.Box row {
    orientation: horizontal;
    halign: fill;
    hexpand: true;
    homogeneous: true;

    Gtk.Box label_cell_0 {
      css-classes: ["mode-cell"];
      halign: fill;
      hexpand: true;

      Gtk.Label label_0 {
        label: "";
        halign: center;
        hexpand: true;
      }
    }
    Gtk.Box label_cell_1 {
      css-classes: ["mode-cell"];
      halign: fill;
      hexpand: true;

      Gtk.Label label_1 {
        label: "";
        halign: center;
        hexpand: true;
      }
    }
    Gtk.Box label_cell_2 {
      css-classes: ["mode-cell"];
      halign: fill;
      hexpand: true;

      Gtk.Label label_2 {
        label: "";
        halign: center;
        hexpand: true;
      }
    }
  }

  // A single sliding indicator (not three dots). It is dot_row's only child,
  // left-aligned at rest; ModeSelector translates it to the active label's
  // center via a runtime CssProvider, and the CSS `transition: transform`
  // (an overshoot / elastic curve) gives the slide a bouncy landing. dot_row is
  // the same width as the label row above (both hexpand/fill in the vertical
  // ModeSelector box), so cell_width = dot_row width / 3 keeps the indicator
  // centered under each of the three labels.
  Gtk.Box dot_row {
    orientation: horizontal;
    halign: fill;
    hexpand: true;

    Gtk.Box mode_dot_indicator {
      halign: start;
      css-classes: ["mode-dot"];
    }
  }
}
