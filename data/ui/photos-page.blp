using Gtk 4.0;
using Adw 1;

template $PhotosPage : Adw.NavigationPage {
  title: "";

  child: Gtk.Box root_box {
    orientation: vertical;

    // Select-all (text) stays on the left (`[start]`); the batch actions live
    // on the right (`[end]`). The batch-action buttons use the shared always-on
    // `.glass-toolbar-button` glass (they only appear in selection mode, so a
    // persistent capsule helps them stand out). Adw.HeaderBar packs `[end]`
    // children edge-first (first declared = rightmost), so the right group is
    // declared in reverse of its left-to-right order:
    // add_to_album, favorite, delete_to_trash.
    Adw.HeaderBar header_bar {
      show-end-title-buttons: true;
      css-classes: ["glass-header"];

      // Select-all (text) stays on the left (`[start]`); the batch actions live
      // on the right (`[end]`). The batch-action buttons use the shared always-on
      // `.glass-toolbar-button` glass (they only appear in selection mode, so a
      // persistent capsule helps them stand out). Adw.HeaderBar packs `[end]`
      // children edge-first (first declared = rightmost), so the right group is
      // declared in reverse of its left-to-right order:
      // add_to_album, favorite, delete_to_trash.
      //
      // Each selection-gated button is wrapped in a Gtk.Revealer so entering/
      // leaving selection mode slides it in/out instead of snapping. A
      // horizontal slide transition collapses the revealer to zero width when
      // not revealed, so the header never reserves empty space. `[start]`
      // revealers use slide_right, `[end]` revealers use slide_left.

      // Keep search first among the start children so its position matches
      // AlbumDetailPage when the selection revealers are hidden.
      [start]
      Gtk.Button search_btn {
        icon-name: "system-search-symbolic";
        tooltip-text: "";
        css-classes: ["glass-toolbar-button", "round-search-button"];
      }

      // Library-overview disclosure. The panel below used to be reachable only
      // by overscrolling past the first row, which nothing announces (P2-8).
      // Same round glass button as search — no new material — and its glyph and
      // tooltip follow the revealer's own state, so a click and a pull can
      // never disagree. Declared right after search so selection chrome sliding
      // in never moves it.
      [start]
      Gtk.Button overview_toggle_btn {
        icon-name: "pan-down-symbolic";
        tooltip-text: "";
        css-classes: ["glass-toolbar-button", "round-search-button"];
      }

      // Multi-select has no persistent header entry (removed by owner
      // decision): it is entered from the tile context menu (right-click /
      // long-press) or with Space / Ctrl+A, and left via the exit revealer.

      [start]
      Gtk.Revealer select_all_revealer {
        transition-type: slide_right;
        reveal-child: false;

        Gtk.Button select_all_btn {
          css-classes: ["glass-toolbar-button"];
        }
      }

      // Exit multi-select. Visible only while multi-select is active — even
      // with zero selection — so the user is never stuck in multi-select.
      [start]
      Gtk.Revealer exit_multi_select_revealer {
        transition-type: slide_right;
        reveal-child: false;

        Gtk.Button exit_multi_select_btn {
          css-classes: ["glass-toolbar-button"];
        }
      }

      [end]
      Gtk.Revealer delete_to_trash_revealer {
        transition-type: slide_left;
        reveal-child: false;

        Gtk.Button delete_to_trash_btn {
          icon-name: "user-trash-symbolic";
          tooltip-text: "";
          css-classes: ["glass-toolbar-button", "glass-toolbar-danger"];
        }
      }

      [end]
      Gtk.Revealer favorite_revealer {
        transition-type: slide_left;
        reveal-child: false;

        // The hint is an overlay, not a second control: the heart stays the only
        // button (the design contract forbids splitting favorite/unfavorite), and
        // a corner glyph says "this one opens a menu" for the mixed selection
        // without changing the button's 38 px round allocation.
        Gtk.Overlay favorite_btn_host {
          child: Gtk.Button favorite_btn {
            // 收藏智能切换：全选已收藏→红心(复用 viewer 的 viewer-favorite-btn
            // + favorite-active)，点击全部取消收藏；全未收藏→点击全部收藏；
            // 混合→点击弹出 glass-menu 菜单。见 photos_page.rs。
            icon-name: "emblem-favorite-symbolic";
            tooltip-text: "";
            css-classes: ["glass-toolbar-button", "viewer-favorite-btn"];
          };

          [overlay]
          Gtk.Image favorite_menu_hint {
            // The heart's tooltip and accessible name already say a choice opens;
            // this glyph is the pointer-visible echo of that, so it stays out of
            // the tree rather than announcing itself as an unnamed image.
            accessible-role: presentation;
            can-target: false;
            visible: false;
            icon-name: "pan-down-symbolic";
            pixel-size: 12;
            halign: end;
            valign: end;
            margin-end: 3;
            margin-bottom: 2;
          }
        }
      }

      [end]
      Gtk.Revealer add_to_album_revealer {
        transition-type: slide_left;
        reveal-child: false;

        Gtk.Button add_to_album_btn {
          icon-name: "list-add-symbolic";
          tooltip-text: "";
          // Hidden until user has selected one or more photos.
          css-classes: ["glass-toolbar-button"];
        }
      }

      // What the batch buttons act on, sitting immediately left of them: the
      // buttons say *what* happens, this says *to how many*. It is NOT in the
      // header's title slot on purpose — an Adw.HeaderBar inside an
      // Adw.NavigationPage auto-displays the page title there, so setting
      // `title-widget` would delete 「照片」 (and the album name on the album
      // page) whenever nothing is selected. Declared last because `[end]` packs
      // edge-first, which makes this the leftmost of the right group.
      [end]
      Gtk.Revealer selection_count_revealer {
        transition-type: slide_left;
        reveal-child: false;

        Gtk.Label selection_count_label {
          css-classes: ["selection-count"];
          ellipsize: end;
          max-width-chars: 24;
        }
      }
    }

    Gtk.Revealer scroll_date_revealer {
      transition-type: crossfade;
      transition-duration: 200;
      reveal-child: false;
      margin-start: 12;
      margin-top: 12;
      margin-bottom: 8;
      halign: start;
      can-target: false;

      Gtk.Label scroll_date_label {
        css-classes: ["scroll-date-label"];
      }
    }

    Gtk.Revealer overview_revealer {
      transition-type: slide_down;
      transition-duration: 220;
      reveal-child: false;

      Gtk.Box overview_panel {
        orientation: vertical;
        spacing: 8;
        margin-bottom: 14;
        hexpand: true;
        css-classes: ["photos-overview"];

        Gtk.Label overview_count_label {
          label: "";
          halign: center;
          xalign: 0.5;
          css-classes: ["photos-overview-count"];
        }

        Gtk.Box overview_sync_row {
          orientation: horizontal;
          spacing: 8;
          halign: center;
          css-classes: ["photos-overview-sync-row"];

          Gtk.Overlay overview_sync_icon_host {
            width-request: 18;
            height-request: 18;

            // The state is spelled out by overview_sync_label next to it, so the
            // glyph stays out of the accessibility tree rather than being read
            // twice (or, worse, as an unnamed image).
            child: Gtk.Image overview_sync_icon {
              accessible-role: presentation;
              icon-name: "folder-remote-symbolic";
              pixel-size: 18;
            };

            [overlay]
            Gtk.DrawingArea overview_sync_spinner {
              visible: false;
              width-request: 18;
              height-request: 18;
            }
          }

          Gtk.Label overview_sync_label {
            label: "";
            halign: center;
            xalign: 0.5;
            wrap: true;
          }

          // A failed sync used to be a sentence with no way out (P2-8). Rust
          // shows this only for the failed states, and labels it from
          // common.retry; it is a plain flat button so the row stays one line of
          // information instead of a control bar.
          Gtk.Button overview_sync_retry_btn {
            visible: false;
            css-classes: ["flat", "photos-overview-retry"];
          }
        }
      }
    }

    Gtk.Overlay grid_overlay {
      vexpand: true;
      hexpand: true;

      child: Gtk.Stack view_stack {
        vexpand: true;
        hexpand: true;
        // Crossfade year/month/day grids (and the empty-state child) on switch.
        // GtkStack owns transition-type; AdwViewStack (the previous type) does
        // not, which is why this is a GtkStack now.
        transition-type: crossfade;
        transition-duration: 200;
      };

      [overlay]
      $ModeSelector mode_selector {
        halign: center;
        valign: end;
        margin-bottom: 24;
      }

    }
  };
}
