using Gtk 4.0;
using Adw 1;

template $SearchPage : Adw.NavigationPage {
  title: "";

  child: Gtk.Box root_box {
    orientation: vertical;

    Adw.HeaderBar header_bar {
      show-end-title-buttons: true;
      css-classes: ["glass-header"];
    }

    Gtk.Box search_panel {
      orientation: vertical;
      margin-start: 16;
      margin-end: 16;
      margin-top: 12;
      margin-bottom: 8;
      spacing: 8;

      Gtk.SearchEntry search_entry {
        hexpand: true;
      }

      Gtk.Box search_field_bar {
        orientation: horizontal;
        halign: center;
        spacing: 2;
        homogeneous: true;
        css-classes: ["glass-raised", "glass-segmented"];

        // Labels come from i18n: search.field.all, search.field.name,
        // search.field.date, set in SearchPage::new(). A template literal here
        // would stay Chinese in an English session, and tools/assert-at-spi.py
        // reads those same keys to know what a screen reader should announce.
        Gtk.ToggleButton field_all {
          css-classes: ["glass-segment"];
          label: "";
          active: true;
        }

        Gtk.ToggleButton field_name {
          css-classes: ["glass-segment"];
          label: "";
        }

        Gtk.ToggleButton field_date {
          css-classes: ["glass-segment"];
          label: "";
        }
      }
    }

    Gtk.Box content_box {
      orientation: vertical;
      spacing: 12;
      vexpand: true;
      hexpand: true;
      margin-start: 16;
      margin-end: 16;
      margin-bottom: 16;

      // Slow-query indicator. It sits above the results instead of replacing
      // them, so a re-run never blanks the grid the user is still looking at.
      Gtk.Box search_busy_box {
        orientation: horizontal;
        halign: center;
        visible: false;

        Gtk.Spinner search_spinner {
          width-request: 16;
          height-request: 16;
        }
      }

      // Overlay host for the result sections' right-click menu. GlassContextMenu
      // renders into a page-level Gtk.Overlay (same contract as photos-page's
      // grid_overlay), so the menu is not clipped by the scrolled grid it was
      // opened from.
      Gtk.Overlay search_overlay {
        vexpand: true;
        hexpand: true;

        child: Gtk.Stack search_state_stack {
          vexpand: true;
          hexpand: true;
          // The result grid and the placeholder pages want very different sizes;
          // a homogeneous stack would let whichever page is hidden set the height.
          hhomogeneous: false;
          vhomogeneous: false;
          transition-type: crossfade;
          transition-duration: 200;

          Gtk.Box search_results_box {
            orientation: vertical;
            spacing: 12;
            hexpand: true;

            Gtk.Box image_results_box {
              orientation: vertical;
              spacing: 8;
              hexpand: true;
              css-classes: ["search-results-section"];
            }

            Gtk.Box video_results_box {
              orientation: vertical;
              spacing: 8;
              hexpand: true;
              css-classes: ["search-results-section"];
            }
          }
        };
      }
    }
  };
}
